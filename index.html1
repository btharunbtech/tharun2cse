<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>website</title>
</head>
<body>
    <style>
        body {
    font-family: Arial, sans-serif;
    background: #080d1a;
    color: white;
}

/* Navigation */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 8%;
    background: #0d1426;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 28px;
    font-weight: bold;
}

.logo span {
    color: #00c8ff;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 12px;
    transition: 0.3s;
}

nav a:hover {
    color: #00c8ff;
}

.nav-btn {
    background: #00c8ff;
    padding: 12px 25px;
    color: #080d1a;
    text-decoration: none;
    border-radius: 25px;
    font-weight: bold;
}

/* Home Section */
.home {
    min-height: 90vh;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 70px 10%;
    gap: 40px;
}

.home-content {
    max-width: 600px;
}

.welcome {
    color: #00c8ff;
    letter-spacing: 4px;
    font-size: 13px;
    margin-bottom: 20px;
}

h1 {
    font-size: 55px;
    margin-bottom: 15px;
}

h1 span {
    color: #00c8ff;
}

.home h2 {
    font-size: 28px;
    color: #aaa;
}

.intro {
    color: #b8c1d1;
    line-height: 1.8;
    margin: 25px 0;
}

.buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.primary-btn,
.secondary-btn {
    padding: 14px 25px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.primary-btn {
    background: #00c8ff;
    color: #080d1a;
}

.secondary-btn {
    border: 1px solid #00c8ff;
    color: white;
}

.primary-btn:hover,
.secondary-btn:hover {
    transform: translateY(-5px);
}

/* Profile Image */
.profile img {
    width: 320px;
    height: 320px;
    object-fit: cover;
    border-radius: 50%;
    border: 5px solid #00c8ff;
    box-shadow: 0 0 35px #00c8ff55;
}

/* Common Section */
section:not(.home) {
    padding: 80px 10%;
}

section:not(.home) h2 {
    text-align: center;
    font-size: 36px;
    margin-bottom: 35px;
}

section h2 span {
    color: #00c8ff;
}

/* About */
.about {
    background: #101a30;
    text-align: center;
}

.about p {
    max-width: 800px;
    margin: auto;
    line-height: 2;
    color: #c1c9d8;
}

/* Skills */
.skill-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.skill-card {
    background: #121e35;
    padding: 35px 20px;
    text-align: center;
    border-radius: 15px;
    border: 1px solid #24344f;
    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-8px);
    border-color: #00c8ff;
}

.skill-card h3 {
    color: #00c8ff;
    margin-bottom: 12px;
}

.skill-card p {
    color: #aaa;
}

/* Projects */
.projects {
    background: #101a30;
}

.project-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.project-card {
    background: #17243d;
    padding: 35px;
    border-radius: 15px;
    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-8px);
}

.project-card h3 {
    color: #00c8ff;
    margin-bottom: 20px;
}

.project-card p {
    color: #c1c9d8;
    line-height: 1.8;
    margin-bottom: 20px;
}

.project-card span {
    color: #00c8ff;
    font-size: 14px;
}

/* Education */
.education-card {
    max-width: 650px;
    margin: auto;
    padding: 35px;
    background: #121e35;
    border-left: 4px solid #00c8ff;
    line-height: 2;
}

.education-card h3 {
    color: #00c8ff;
}

.education-card p {
    color: #c1c9d8;
}

.education-card span {
    color: #00c8ff;
}

/* Contact */
.contact {
    background: #101a30;
    text-align: center;
}

.contact p {
    color: #aaa;
    margin-bottom: 30px;
}

.contact a {
    display: inline-block;
    background: #00c8ff;
    color: #080d1a;
    text-decoration: none;
    padding: 14px 25px;
    border-radius: 25px;
    margin: 10px;
    font-weight: bold;
}

/* Footer */
footer {
    background: #080d1a;
    text-align: center;
    padding: 30px;
    color: #8994a8;
    line-height: 2;
}

@media (max-width: 768px) {

    header {
        flex-direction: column;
        gap: 20px;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    nav a {
        margin: 0;
    }

    .home {
        flex-direction: column-reverse;
        text-align: center;
    }

    .profile img {
        width: 220px;
        height: 220px;
    }

    h1 {
        font-size: 40px;
    }

    .buttons {
        justify-content: center;
    }

    .skill-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .project-container {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 450px) {
    .skill-container {
        grid-template-columns: 1fr;
    }

    section:not(.home) {
        padding: 60px 6%;
    }
}
        

    </style>
    <header>
        <div class="logo"> BANDI TARUN<span>.</span></div>

        <nav>
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#skills">Skills</a>
            <a href="#projects">Projects</a>
            <a href="#contact">Contact</a>
        </nav>

        <a href="#contact" class="nav-btn">Hire Me</a>
    </header>

    <section class="home" id="home">

        <div class="home-content">
            <p class="welcome">WELCOME TO MY PORTFOLIO</p>

            <h1>Hello, I'm <span> Bandi Tarun</span></h1>

            <h2>Software Developer</h2>

            <p class="intro">
                I'm a Computer Science graduate passionate about
                building beautiful websites and learning new technologies.
                I enjoy turning ideas into interactive digital experiences.
            </p>

            <div class="buttons">
                <a href="#projects" class="primary-btn">View My Work</a>
                <a href="#contact" class="secondary-btn">Contact Me</a>
            </div>
        </div>

        <div class="profile">
            <img
            src="https://images.unsplash.com/photo-1500648767791-00dcc994a43b?w=600"
            alt="Profile photo">
        </div>

    </section>

    <section class="about" id="about">

        <h2>About <span>Me</span></h2>

        <p>
            My name is Tarun. I am a B.Tech Computer Science
            and Engineering graduate from Dr. K. V. Subba Reddy
            Institute of Technology, Kurnool.

            Motivated and dedicated Computer Science and Engineering graduate with a strong interest in technology and software development. 
Possess a basic understanding of programming, problem-solving, and real-world application development. Familiar with HTML, CSS, JavaScript, React.js, Java, and MySQL. Eager to learn new technologies, contribute to software development projects, and build a successful career in the IT industry 

        </p>

    </section>

    <section class="skills" id="skills">

        <h2>My <span>Skills</span></h2>
           <div class="skill-container">

            <div class="skill-card">
                <h3>HTML5</h3>
                <p>Web Structure</p>
            </div>

            <div class="skill-card">
                <h3>CSS</h3>
                <p>Web Designing</p>
            </div>

            <div class="skill-card">
                <h3>JavaScript</h3>
                <p>Web Interactivity</p>
            </div>

            <div class="skill-card">
                <h3>React.js</h3>
                <p>Frontend Development</p>
            </div>

            <div class="skill-card">
                <h3>Java</h3>
                <p>Programming</p>
            </div>

            <div class="skill-card">
                <h3>MySQL</h3>
                <p>Database</p>
            </div>

        </div>

    </section>
    <section class="projects" id="projects">

        <h2>My <span>Projects</span></h2>

        <div class="project-container">

            <div class="project-card">
                <h3>Image Deblurring Using GAN</h3>

                <p>
                    A deep learning project designed to restore
                    motion-blurred images using Generative
                    Adversarial Networks.
                </p>

                <span>Python | Deep Learning | GAN</span>
            </div>

            <div class="project-card">
                <h3>Personal Portfolio Website</h3>

                <p>
                    A responsive personal portfolio website
                    developed to showcase my skills, education
                    and projects.
                </p>

                <span>HTML | CSS</span>
            </div>

        </div>

    </section>

    <section class="education">

        <h2>My <span>Education</span></h2>

        <div class="education-card">
            <h3>Bachelor of Technology</h3>
            <p>Computer Science and Engineering</p>
            <p>Dr. K. V. Subba Reddy Institute of Technology, Kurnool</p>
            <span>2026</span>
        </div>

    </section>

    <section class="contact" id="contact">

        <h2>Contact <span>Me</span></h2>

        <p>Let's connect and build something amazing together.</p>

        <a href="mailto:btharunbtech@gmail.com">
            Email Me
        </a>

        <a href="https://www.linkedin.com/in/b-tarun-a47248372"
           target="_blank">
            LinkedIn Profile
        </a>

    </section>

    <footer>
        <p> @ All Rights Reserved.</p>
        <p>Designed with Tarun ❤️ using HTML & CSS</p>
    </footer>
    
</body>
</html>